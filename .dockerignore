# Build-context hygiene — keep the API build context to a few MB and never
# ship git history, the 6 GB venv, the 132 MB data archive, run products or
# model weights inside an image layer.
.git
.venv
data_for_sih_2026.zip
**/*.zip
__pycache__
**/__pycache__
*.pyc
**/*.pyc
backend/uploads
backend/outputs
backend/.pytest_cache
.pytest_cache
**/.pytest_cache
# Weights are mounted at runtime (${MODELS_DIR}:/app/models), never baked in.
models/*.pt
models/*.ckpt
# Not part of the API image (frontend has its own build context).
.superpowers
tasks
TODOs.md
backend/benchmark_results
